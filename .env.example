# Emergent Environment Configuration

# ===================
# Satellite Module
# ===================

# NASA FIRMS Active Fire Feed URL (choose one):
# Option 1: VIIRS 375m resolution (recommended)
FIRMS_URL=https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-20-viirs-c2/csv/J1_VIIRS_C2_Global_24h.csv

# Option 2: MODIS 1km resolution
# FIRMS_URL=https://firms.modaps.eosdis.nasa.gov/data/active_fire/modis-c6.1/csv/MODIS_C6_1_Global_24h.csv

# Option 3: GeoJSON format
# FIRMS_URL=https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-20-viirs-c2/geojson/J1_VIIRS_C2_Global_24h.geojson

# Polling interval (seconds) - how often to fetch new data
POLL_SECONDS=300

# Time window for clustering (minutes) - only cluster recent detections
WINDOW_MIN=90

# DBSCAN clustering parameters
EPS_KM=5.0        # Max distance between points in a cluster (km)
MIN_PTS=3         # Minimum points required to form a cluster

# ===================
# General Configuration
# ===================

# API Configuration (if needed)
# API_PORT=8000
# API_HOST=0.0.0.0

# Logging Level
# LOG_LEVEL=INFO
