# Emergent Environment Configuration

# ============================================================================
# Satellite Data Sources
# ============================================================================

# NASA FIRMS Active Fire Feed URL (choose one):
# Option 1: VIIRS 375m resolution (recommended)
FIRMS_URL=https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-20-viirs-c2/csv/J1_VIIRS_C2_Global_24h.csv

# Option 2: MODIS 1km resolution
# FIRMS_URL=https://firms.modaps.eosdis.nasa.gov/data/active_fire/modis-c6.1/csv/MODIS_C6_1_Global_24h.csv

# Option 3: GeoJSON format
# FIRMS_URL=https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-20-viirs-c2/geojson/J1_VIIRS_C2_Global_24h.geojson

# USGS Earthquake Feed (GeoJSON)
# Options: all_hour, 2.5_day, 4.5_day, significant_month
# Docs: https://earthquake.usgs.gov/earthquakes/feed/v1.0/geojson.php
USGS_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson

# ============================================================================
# General Configuration
# ============================================================================

# Polling interval for all adapters (seconds) - how often to fetch new data
POLL_SECONDS=300

# Signal retention time (hours) - older signals are pruned to prevent memory leak
SIGNAL_TTL_HOURS=6

# ============================================================================
# Clustering Parameters (Per Hazard)
# ============================================================================

# Fire Clustering (tight spatial, short temporal)
FIRE_EPS_KM=5.0        # Max distance between fire detections (km)
FIRE_MIN_PTS=3         # Min detections to form a fire hotspot
FIRE_WINDOW_MIN=90     # Time window for fire clustering (minutes)

# Earthquake Clustering (wide spatial, long temporal for aftershock grouping)
QUAKE_EPS_KM=30.0      # Max distance between earthquake epicenters (km)
QUAKE_MIN_PTS=2        # Min earthquakes to form a cluster
QUAKE_WINDOW_MIN=1440  # Time window for earthquake clustering (24 hours)

# Backward compatibility (legacy parameters, use hazard-specific above instead)
EPS_KM=5.0
MIN_PTS=3
WINDOW_MIN=90

# ============================================================================
# API Configuration
# ============================================================================

# API_PORT=8000
# API_HOST=0.0.0.0

# Logging Level
# LOG_LEVEL=INFO
